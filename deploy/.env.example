# Copy to /etc/agrichat/agrichat.env, fill in real values on the server only, chmod 600.
# Plain KEY=value lines; values may be wrapped in single quotes. Never commit the filled-in file.

# httpSMS gateway: API key and the gateway phone number used as sender.
HTTPSMS_API_KEY=
HTTPSMS_FROM=

# Shared secret the gateway sends with each webhook call.
WEBHOOK_SECRET=

# Secret used to hash farmer phone numbers. Changing it orphans stored profiles.
PHONE_HASH_SECRET=

# Language model, used only when LLM_ENABLED is true.
# The endpoint, key and deployment name come from the model provider.
LLM_ENABLED=false
LLM_ENDPOINT=
LLM_KEY=
LLM_MODEL=

# Optional: sentence-embedding model for WHY retrieval; leave empty to disable retrieval.
EMBEDDING_MODEL=

# SQLite file, relative to the working directory /opt/agrichat; must be under data/.
DB_PATH=data/agrichat.db

# Set to true when the current season is flagged as El Nino.
SEASON_EL_NINO=false

# Admin sign-in: Argon2 hash of the shared password, and the cookie signing secret.
# Generate the hash with the command in README.md. The hash contains "$", so keep it inside single quotes.
ADMIN_PASSWORD_HASH=''
SESSION_SECRET=
